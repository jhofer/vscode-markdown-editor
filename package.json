{
  "name": "inkwell-md",
  "displayName": "inkwell.md",
  "version": "1.2.15",
  "description": "Edit markdown files in preview mode with a rich text editor",
  "categories": [
    "Formatters",
    "Other"
  ],
  "main": "./out/extension.js",
  "browser": "./out/extension.js",
  "engines": {
    "vscode": "^1.125.0"
  },
  "publisher": "jhofer",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhofer/vscode-markdown-editor"
  },
  "bugs": {
    "url": "https://github.com/jhofer/vscode-markdown-editor/issues"
  },
  "icon": "icon.png",
  "contributes": {
    "customEditors": [
      {
        "viewType": "inkwell.md",
        "displayName": "inkwell.md",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "inkwell.md",
      "properties": {
        "inkwell-md.fontSize": {
          "type": "string",
          "markdownDescription": "Base font size",
          "default": "16px",
          "scope": "window"
        },
        "inkwell-md.fontFamily": {
          "type": "string",
          "markdownDescription": "Font family for rendering markdown",
          "default": "-apple-system, system-ui, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif",
          "scope": "window"
        },
        "inkwell-md.preserveEmptyParagraphs": {
          "type": "boolean",
          "markdownDescription": "Preserve intentional empty paragraphs (blank lines) when saving by writing a backslash (`\\`) on each empty line. When disabled, consecutive blank lines collapse into a single paragraph break, keeping the markdown clean. Reopen the editor for a change to take effect.",
          "default": false,
          "scope": "window"
        },
        "inkwell-md.plantumlExternalFiles": {
          "type": "boolean",
          "markdownDescription": "Store PlantUML sources in a `<name>.plantuml` sidecar file next to the markdown document and keep only a generated SVG image link in the markdown, instead of embedding the PlantUML source as a fenced code block. Reopen the editor for a change to take effect.",
          "default": true,
          "scope": "window"
        },
        "inkwell-md.plantumlAttachmentsFolder": {
          "type": "string",
          "markdownDescription": "Folder (relative to the git repository root, or the workspace folder if the file is not in a repo) where SVGs generated from external PlantUML files are written. Only used when `#inkwell-md.plantumlExternalFiles#` is enabled. Reopen the editor for a change to take effect.",
          "default": ".attachments",
          "scope": "window"
        }
      }
    }
  },
  "keywords": [
    "rich",
    "markdown",
    "editor",
    "preview"
  ],
  "author": "jhofer",
  "license": "ISC",
  "scripts": {
    "prepare:plantuml-assets": "node ./scripts/preparePlantumlAssets.js",
    "vscode:prepublish": "npm run build",
    "build": "npm run prepare:plantuml-assets && npm run esbuild-client --  --minify  && npm run esbuild-extension --  --minify ",
    "build-debug": "npm run prepare:plantuml-assets && npm run esbuild-client && npm run esbuild-extension",
    "esbuild-extension": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --sources-content=true",
    "esbuild-client": "esbuild ./src/client --bundle --outfile=out/client.js --sourcemap=inline --sources-content=true",
    "watch-client": "npm run esbuild-client -- --watch",
    "watch-extension": "npm run esbuild-extension -- --watch",
    "lint": "eslint .",
    "test": "jest",
    "update-vsce-login": "vsce login jhofer",
    "package": "vsce package --no-dependencies",
    "publish:latest": "vsce publish --pre-release --no-dependencies",
    "publish:release": "vsce publish --no-dependencies",
    "publish:patch": "vsce publish patch --pre-release --no-dependencies",
    "publish:minor": "vsce publish minor --pre-release --no-dependencies",
    "publish:major": "vsce publish major --pre-release --no-dependencies",
    "publish:preview": "vsce publish --pre-release --no-dependencies",
    "publish:fast": "npm version patch && npm run build && vsce publish --pre-release --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.18",
    "@swc/jest": "^0.2.39",
    "@types/fuzzy-search": "^2.1.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.149",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.125.0",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.8.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.4.4",
    "ts-node": "^10.7.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "codemirror": "^6.0.2",
    "copy-to-clipboard": "^4.0.2",
    "fuzzy-search": "^3.2.1",
    "gemoji": "^8.1.0",
    "lodash": "^4.17.11",
    "markdown-it": "^14.3.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "mermaid": "^11.4.1",
    "outline-icons": "^4.5.0",
    "prosemirror-commands": "^1.1.6",
    "prosemirror-dropcursor": "^1.3.3",
    "prosemirror-gapcursor": "^1.1.5",
    "prosemirror-history": "^1.1.3",
    "prosemirror-inputrules": "^1.1.3",
    "prosemirror-keymap": "^1.1.4",
    "prosemirror-markdown": "^1.5.2",
    "prosemirror-model": "^1.13.3",
    "prosemirror-schema-list": "^1.1.2",
    "prosemirror-search": "^1.1.1",
    "prosemirror-state": "^1.3.4",
    "prosemirror-tables": "^1.1.1",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-utils": "^1.2.2",
    "prosemirror-view": "^1.42.2",
    "react-medium-image-zoom": "^5.4.8",
    "react-portal": "^4.2.1",
    "react-textarea-autosize": "^8.5.4",
    "react-viewer-pan-zoom": "^1.3.1",
    "refractor": "^5.0.0",
    "resize-observer-polyfill": "^1.5.1",
    "slugify": "^1.4.0",
    "smooth-scroll-into-view-if-needed": "^2.0.2"
  }
}
